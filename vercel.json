{
  "version": 2,
  "rewrites": [
    {
      "source": "/l/(.*)",
      "destination": "https://898757.xyz"
    },
    {
      "source": "/sub/(.*)",
      "destination": "https://898757.xyz"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,OPTIONS,PATCH,DELETE,POST,PUT" },
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ]
}
